# 复制为 .env 后按需修改（也可用系统环境变量）

# 必改：生产环境请换成长随机串
SECRET_KEY=change-me-in-production-use-long-random-string

# 数据目录（用户 items / chroma / sqlite）
DATA_DIR=./data

# API
API_HOST=127.0.0.1
API_PORT=8000

# Streamlit 前端连接的后端地址
API_URL=http://127.0.0.1:8000

# socai 可执行文件（本机同步 / 可选的服务端 local-socai）
SOCAI_EXE_PATH=./socai/bin/socai.exe
DOWNLOADS_DIR=./downloads

# 本地 CLI（python sort.py）用的 BYOK，网站用户请在侧边栏填写
# LLM_API_KEY=
# LLM_BASE_URL=https://api-inference.modelscope.cn/v1
# LLM_MODEL_ID=deepseek-ai/DeepSeek-V4-Flash-0731

# 模型路径（默认项目根目录）
# EMBEDDING_MODEL_PATH=./all-MiniLM-L6-v2
# RERANKER_MODEL_PATH=./bge-reranker-base
